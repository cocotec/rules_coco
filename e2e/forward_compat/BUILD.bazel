# E2E forward-compatibility test BUILD file; see MODULE.bazel.

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_coco//coco:cc.bzl", "coco_cc_library")
load("@rules_coco//coco:defs.bzl", "coco_generate", "coco_package", "coco_verify_test")

coco_package(
    name = "forward_compat",
    srcs = glob(["src/**/*.coco"]),
    package = "Coco.toml",
)

coco_verify_test(
    name = "forward_compat_verify",
    package = ":forward_compat",
)

# Pinned to the only registered version, one rules_coco does not know, so the library's
# check compares versions it has no table for.
coco_generate(
    name = "forward_compat_cpp",
    language = "cpp",
    package = ":forward_compat",
    popili_version = "1.5.8",
)

coco_cc_library(
    name = "forward_compat_cc",
    generated_package = ":forward_compat_cpp",
    popili_version = "1.5.8",
)

cc_binary(
    name = "forward_compat_bin",
    srcs = ["test/main.cc"],
    deps = [":forward_compat_cc"],
)
