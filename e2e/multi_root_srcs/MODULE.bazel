module(
    name = "rules_coco_multi_root_srcs_test",
    version = "0.0.0",
)

bazel_dep(name = "rules_coco", version = "")
local_path_override(
    module_name = "rules_coco",
    path = "../..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.18")

coco = use_extension("@rules_coco//coco:extensions.bzl", "coco")
coco.toolchain(cc = True)

# No coco.cc_test_runtime: the test library here compiles test source roots, not mocks, so it
# links the plain runtime; //Main:missing_gmock_test checks that one compiling mocks fails.
