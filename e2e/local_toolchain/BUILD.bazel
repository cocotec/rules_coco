# E2E local-toolchain test BUILD file.
# Exercises code generation + verification against a local popili toolchain.

load("@bazel_features//:features.bzl", "bazel_features")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("@rules_coco//coco:cc.bzl", "coco_cc_library", "coco_cc_test_library")
load("@rules_coco//coco:defs.bzl", "coco_generate", "coco_package", "coco_verify_test")
load(":exec_platform_report.bzl", "exec_platform_probe", "popili_exec_platform_report")
load(":local_off_host_test.bzl", "local_off_host_test", "local_test_off_target_platform_test")

# Define Coco package
coco_package(
    name = "local_toolchain",
    srcs = glob(["src/**/*.coco"]),
    package = "Coco.toml",
)

# Verify the Coco package
coco_verify_test(
    name = "local_toolchain_verify",
    package = ":local_toolchain",
)

# Generate C++ code from Coco
coco_generate(
    name = "local_toolchain_cpp",
    language = "cpp",
    mocks = True,
    package = ":local_toolchain",
)

# Create C++ library from generated code
coco_cc_library(
    name = "local_toolchain_cc",
    generated_package = ":local_toolchain_cpp",
)

# Create C++ test library with mocks
coco_cc_test_library(
    name = "local_toolchain_cc_tst",
    generated_package = ":local_toolchain_cpp",
    deps = [":local_toolchain_cc"],
)

# C++ binary that uses the generated code
cc_binary(
    name = "local_toolchain_bin",
    srcs = ["test/main.cc"],
    deps = [":local_toolchain_cc"],
)

# C++ unit test with GoogleTest
cc_test(
    name = "local_toolchain_test",
    srcs = ["test/local_toolchain_test.cc"],
    deps = [":local_toolchain_cc_tst"],
)

# An execution platform no popili is published for, listed before the host in .bazelrc.
# Only the CPU differs from the host: unconstrained targets such as the auto-detected
# cc_toolchain_config also resolve for it, and rules_cc interprets their tool paths with
# its OS, so a foreign OS breaks MSVC's `C:\...` paths on Windows.
platform(
    name = "foreign",
    constraint_values = ["@platforms//cpu:riscv64"],
    parents = ["@platforms//host"],
)

# Probe toolchains, registered in MODULE.bazel and WORKSPACE; see exec_platform_report.bzl.
toolchain_type(name = "exec_platform_probe_type")

exec_platform_probe(
    name = "probe_foreign_impl",
    exec_platform = "foreign",
)

toolchain(
    name = "probe_foreign",
    exec_compatible_with = ["@platforms//cpu:riscv64"],
    toolchain = ":probe_foreign_impl",
    toolchain_type = ":exec_platform_probe_type",
)

exec_platform_probe(
    name = "probe_host_impl",
    exec_platform = "host",
)

toolchain(
    name = "probe_host",
    toolchain = ":probe_host_impl",
    toolchain_type = ":exec_platform_probe_type",
)

# Fails during analysis if the local toolchain resolves for :foreign or is not registered as
# popili "local", so it needs only be part of //... (like popili_version_report in ../multi_version).
popili_exec_platform_report(
    name = "popili_runs_on_host",
    expected = "host",
    expected_version = "local",
)

# With :foreign as the only execution platform, the host-only local toolchain cannot resolve.
local_off_host_test(
    name = "local_off_host_test",
    size = "small",
    target_under_test = ":local_toolchain",
)

# Bazel 8 has no default test toolchain type, so its tests are not tied to the target platform.
TESTS_FOLLOW_TARGET_PLATFORM = getattr(
    bazel_features.toolchains,
    "has_default_test_toolchain_type",
    False,
)

# Built for :foreign, the verify test runs on :foreign, where the local popili cannot run.
[
    local_test_off_target_platform_test(
        name = "local_test_off_target_platform_test",
        size = "small",
        target_under_test = ":local_toolchain_verify",
    )
    for _ in [None]
    if TESTS_FOLLOW_TARGET_PLATFORM
]
