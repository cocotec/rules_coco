# E2E local-toolchain test WORKSPACE (WORKSPACE mode).

workspace(name = "rules_coco_local_toolchain_test")

load("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

# Use the local development version of rules_coco.
local_repository(
    name = "rules_coco",
    path = "../..",
)

load("@rules_coco//coco:repositories.bzl", "coco_local_repositories")

# stage.py writes the licence protocol version the staged popili reads.
load("//staged:license.bzl", "LICENSE_PROTOCOL_VERSION")

# Register a toolchain from a local popili path (./staged; see stage.py). Like in bzlmod, it
# is only selected with --@rules_coco//:version=local, which .bazelrc sets for both modes.
coco_local_repositories(
    cc_runtime_path = "staged/cpp-runtime",
    license_protocol_version = LICENSE_PROTOCOL_VERSION,
    path = "staged/popili",
)

# Probe toolchains for :popili_runs_on_host; the foreign one first, like the platforms.
register_toolchains(
    "//:probe_foreign",
    "//:probe_host",
)

load("@bazel_skylib//:workspace.bzl", "bazel_skylib_workspace")

# Registers the unittest toolchains the analysis tests in BUILD.bazel need.
bazel_skylib_workspace()

# Load GoogleTest for C++ unit tests
load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "googletest",
    sha256 = "a436f388c7f1305c3fe30a6a21c490893d159cfd8dfdcf9eeb20983994192869",
    strip_prefix = "googletest-6450691fd7d07ef932582206fbafb1a513927e08",
    urls = ["https://github.com/google/googletest/archive/6450691fd7d07ef932582206fbafb1a513927e08.zip"],
)
