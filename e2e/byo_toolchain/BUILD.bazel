# Verifies a Coco package using the bring-your-own coco_toolchain, and checks that a target asking
# for another popili version than the toolchain provides fails (see byo_version_test.bzl).

load("@rules_coco//coco:defs.bzl", "coco_generate", "coco_package", "coco_verify_test")
load("//popili_dist:bin/version.bzl", "POPILI_VERSION")
load(":byo_version_test.bzl", "UNPROVIDED_VERSION", "byo_version_tests")

coco_package(
    name = "byo_toolchain",
    srcs = glob(["src/**/*.coco"]),
    package = "Coco.toml",
)

coco_verify_test(
    name = "byo_toolchain_verify",
    package = ":byo_toolchain",
)

# Pinned to the version the toolchain provides, which therefore serves it.
coco_verify_test(
    name = "byo_toolchain_pinned_verify",
    package = ":byo_toolchain",
    popili_version = POPILI_VERSION,
)

# Pinned to another version than //tools:byo_popili provides, which serves it all the same and fails the build.
coco_generate(
    name = "unprovided_cpp",
    language = "cpp",
    package = ":byo_toolchain",
    popili_version = UNPROVIDED_VERSION,
    tags = ["manual"],
)

# The same package with popili_versions, analysed only, by the tests: one list leaves out the
# version the toolchain provides, the other names it next to one it does not provide.
coco_package(
    name = "lists_unprovided",
    srcs = glob(["src/**/*.coco"]),
    package = "Coco.toml",
    popili_versions = [UNPROVIDED_VERSION],
    tags = ["manual"],
)

coco_package(
    name = "lists_staged",
    srcs = glob(["src/**/*.coco"]),
    package = "Coco.toml",
    popili_versions = [
        POPILI_VERSION,
        UNPROVIDED_VERSION,
    ],
    tags = ["manual"],
)

byo_version_tests(
    name = "byo_version",
    lists_staged = ":lists_staged",
    lists_unprovided = ":lists_unprovided",
    pinned = ":byo_toolchain_pinned_verify",
    staged_version = POPILI_VERSION,
    unprovided = ":unprovided_cpp",
)
