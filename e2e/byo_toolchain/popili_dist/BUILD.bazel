# Exposes the staged bin/popili (gitignored) as a single-file label for //tools. The wildcard
# tolerates the .exe suffix; the exclude drops popili-language-server.
filegroup(
    name = "popili",
    srcs = glob(
        ["bin/popili*"],
        allow_empty = True,
        exclude = ["bin/popili-language-server*"],
    ),
    visibility = ["//visibility:public"],
)
