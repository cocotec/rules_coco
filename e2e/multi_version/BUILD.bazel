# E2E test for multi-version support in rules_coco: several popili versions registered at once
# (1.5.0, the default, and 1.5.1; see MODULE.bazel and WORKSPACE), selected per package and per
# workspace with popili_version, and forced over a subgraph with with_popili_version.
#
# Which popili each target actually uses is asserted directly with popili_version_report,
# rather than inferred from a successful verify: every registered version can verify every
# package here. popili_version_report fails during analysis, so these need only be part of
# //... -- no test rule, and deliberately no build_test, whose generated genrules need bash.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_coco//coco:cc.bzl", "coco_cc_library")
load("@rules_coco//coco:defs.bzl", "coco_generate", "coco_package", "coco_state_diagram", "coco_verify_test", "coco_workspace", "with_popili_version")
load(
    ":exec_platform_tests.bzl",
    "exec_platform_local_acquire_license_test",
    "exec_platform_local_user_license_test",
    "exec_platform_runs_package_version_test",
    "exec_platform_unpublished_test",
)
load(":pinning_failure_test.bzl", "pinning_failure_test")
load(":popili_version_report.bzl", "popili_version_report")
load(":typecheck_tests.bzl", "typecheck_flag_151_test", "typecheck_test")

# ---------------------------------------------------------------------------------------------
# Version selection without pins
# ---------------------------------------------------------------------------------------------

# Unwrapped: the first entry of versions/coco.toolchain is the default.
popili_version_report(
    name = "popili_is_150_by_default",
    expected_repo_suffix = "__1_5_0",
)

# Wrapped: with_popili_version selects the other registered version. Manual, because built
# directly it would resolve the default version and fail by design; it is reached only through
# the wrapper below.
popili_version_report(
    name = "popili_is_151_impl",
    expected_repo_suffix = "__1_5_1",
    tags = ["manual"],
)

with_popili_version(
    name = "popili_is_151",
    target = ":popili_is_151_impl",
    version = "1.5.1",
)

# ---------------------------------------------------------------------------------------------
# An unpinned library, used by packages on both versions
# ---------------------------------------------------------------------------------------------

coco_package(
    name = "shared",
    srcs = ["shared/src/Shared.coco"],
    package = "shared/Coco.toml",
)

popili_version_report(
    name = "shared_is_default",
    expected_repo_suffix = "__1_5_0",
    package = ":shared",
)

# ---------------------------------------------------------------------------------------------
# Package pins: modern pins 1.5.0, legacy pins 1.5.1
# ---------------------------------------------------------------------------------------------

coco_package(
    name = "modern",
    srcs = ["modern/src/Example.coco"],
    package = "modern/Coco.toml",
    popili_version = "1.5.0",
)

coco_verify_test(
    name = "modern_verify",
    package = ":modern",
)

coco_generate(
    name = "modern_cpp",
    language = "cpp",
    package = ":modern",
)

coco_cc_library(
    name = "modern_cc",
    generated_package = ":modern_cpp",
)

popili_version_report(
    name = "modern_is_150",
    expected_repo_suffix = "__1_5_0",
    package = ":modern",
)

popili_version_report(
    name = "modern_cpp_is_150",
    expected_repo_suffix = "__1_5_0",
    generated = ":modern_cpp",
)

popili_version_report(
    name = "modern_cc_links_150",
    expected_repo_suffix = "__1_5_0",
    library = ":modern_cc",
)

coco_package(
    name = "legacy",
    srcs = ["legacy/src/Example.coco"],
    package = "legacy/Coco.toml",
    popili_version = "1.5.1",
    typecheck = True,
    deps = [":shared"],
)

coco_verify_test(
    name = "legacy_verify",
    package = ":legacy",
)

coco_generate(
    name = "legacy_cpp",
    language = "cpp",
    package = ":legacy",
)

coco_cc_library(
    name = "legacy_cc",
    generated_package = ":legacy_cpp",
)

# legacy depends on the unpinned shared package: no warning, and legacy keeps its pin.
popili_version_report(
    name = "legacy_is_151",
    expected_repo_suffix = "__1_5_1",
    package = ":legacy",
)

popili_version_report(
    name = "legacy_cpp_is_151",
    expected_repo_suffix = "__1_5_1",
    generated = ":legacy_cpp",
)

popili_version_report(
    name = "legacy_cc_links_151",
    expected_repo_suffix = "__1_5_1",
    library = ":legacy_cc",
)

# ---------------------------------------------------------------------------------------------
# Unpinned package depending on a pinned one: the dependency's pin is ignored, with a warning
# ---------------------------------------------------------------------------------------------

# uses_legacy has no pin and no workspace, so it resolves the default 1.5.0 even though its
# dependency legacy pins 1.5.1. legacy's sources are processed with 1.5.0 here.
coco_package(
    name = "uses_legacy",
    srcs = ["uses_legacy/src/UsesLegacy.coco"],
    package = "uses_legacy/Coco.toml",
    deps = [":legacy"],
)

coco_verify_test(
    name = "uses_legacy_verify",
    package = ":uses_legacy",
)

coco_generate(
    name = "uses_legacy_cpp",
    language = "cpp",
    package = ":uses_legacy",
)

coco_cc_library(
    name = "uses_legacy_cc",
    generated_package = ":uses_legacy_cpp",
)

popili_version_report(
    name = "uses_legacy_is_150_and_warns",
    expected_repo_suffix = "__1_5_0",
    expected_warnings = ['//:uses_legacy depends on it and uses popili "1.5.0"'],
    package = ":uses_legacy",
)

popili_version_report(
    name = "uses_legacy_cpp_is_150",
    expected_repo_suffix = "__1_5_0",
    generated = ":uses_legacy_cpp",
)

popili_version_report(
    name = "uses_legacy_cc_links_150",
    expected_repo_suffix = "__1_5_0",
    library = ":uses_legacy_cc",
)

# flexible depends on modern, pinned to 1.5.0: the version flexible resolves to anyway. A pin
# that agrees is not worth a warning.
coco_package(
    name = "flexible",
    srcs = ["flexible/src/Flexible.coco"],
    package = "flexible/Coco.toml",
    deps = [":modern"],
)

coco_verify_test(
    name = "flexible_verify",
    package = ":flexible",
)

popili_version_report(
    name = "flexible_is_150_without_warnings",
    expected_repo_suffix = "__1_5_0",
    expected_warnings = [],
    package = ":flexible",
)

# ---------------------------------------------------------------------------------------------
# Workspace pins
# ---------------------------------------------------------------------------------------------

coco_workspace(
    name = "ws150",
    popili_version = "1.5.0",
    workspace = "ws150/Coco.toml",
)

# ws_app is unpinned, so it inherits 1.5.0 from its workspace, and warns that the pin of its
# dependency legacy (1.5.1) is ignored. The unpinned shared package raises no warning.
coco_package(
    name = "ws_app",
    srcs = ["ws150/app/src/WsApp.coco"],
    package = "ws150/app/Coco.toml",
    typecheck = True,
    workspace = ":ws150",
    deps = [
        ":legacy",
        ":shared",
    ],
)

coco_verify_test(
    name = "ws_app_verify",
    package = ":ws_app",
)

coco_generate(
    name = "ws_app_cpp",
    language = "cpp",
    package = ":ws_app",
)

coco_cc_library(
    name = "ws_app_cc",
    generated_package = ":ws_app_cpp",
)

popili_version_report(
    name = "ws_app_is_150_and_warns",
    expected_repo_suffix = "__1_5_0",
    expected_warnings = ['//:ws_app depends on it and uses popili "1.5.0"'],
    package = ":ws_app",
)

popili_version_report(
    name = "ws_app_cc_links_150",
    expected_repo_suffix = "__1_5_0",
    library = ":ws_app_cc",
)

# A package pinning a different version from its workspace is rejected.
coco_package(
    name = "ws_app_disagrees",
    srcs = ["ws150/app/src/WsApp.coco"],
    package = "ws150/app/Coco.toml",
    popili_version = "1.5.1",
    tags = ["manual"],
    workspace = ":ws150",
)

pinning_failure_test(
    name = "ws_app_disagrees_test",
    expected_messages = [
        '//:ws_app_disagrees pins popili_version "1.5.1", but its workspace ',
        '//:ws150 pins "1.5.0"',
    ],
    target_under_test = ":ws_app_disagrees",
)

# ---------------------------------------------------------------------------------------------
# with_popili_version forces a version over every pin in the subgraph it wraps
# ---------------------------------------------------------------------------------------------

# modern pins 1.5.0; wrapping it, its code generation or its library moves all of it to 1.5.1.
with_popili_version(
    name = "modern_on_151",
    target = ":modern",
    version = "1.5.1",
)

with_popili_version(
    name = "modern_cpp_on_151",
    target = ":modern_cpp",
    version = "1.5.1",
)

with_popili_version(
    name = "modern_cc_on_151",
    target = ":modern_cc",
    version = "1.5.1",
)

# Verifying the wrapped package runs popili 1.5.1, as the report below asserts for its toolchain.
coco_verify_test(
    name = "modern_verify_on_151",
    package = ":modern_on_151",
)

popili_version_report(
    name = "modern_on_151_is_151",
    expected_repo_suffix = "__1_5_1",
    package = ":modern_on_151",
)

popili_version_report(
    name = "modern_cpp_on_151_is_151",
    expected_repo_suffix = "__1_5_1",
    generated = ":modern_cpp_on_151",
)

popili_version_report(
    name = "modern_cc_on_151_links_151",
    expected_repo_suffix = "__1_5_1",
    library = ":modern_cc_on_151",
)

# A target depending on a wrapper stays in its own configuration, but uses what the wrapper
# forwards: here the code and runtime of a wrapped library (modern_on_151_is_151 above checks
# the toolchain a wrapped package forwards). Manual: the report only needs its providers.
cc_library(
    name = "uses_modern_cc_on_151",
    tags = ["manual"],
    deps = [":modern_cc_on_151"],
)

popili_version_report(
    name = "wrapped_library_consumer_links_151",
    expected_repo_suffix = "__1_5_1",
    library = ":uses_modern_cc_on_151",
)

# Forcing also silences the warning: uses_legacy and legacy now agree.
with_popili_version(
    name = "uses_legacy_on_151",
    target = ":uses_legacy",
    version = "1.5.1",
)

popili_version_report(
    name = "uses_legacy_on_151_is_151_without_warnings",
    expected_repo_suffix = "__1_5_1",
    expected_warnings = [],
    package = ":uses_legacy_on_151",
)

# Forcing an unregistered version is rejected. The pinned package below the wrapper is analysed
# first, so it is the one reporting the error.
with_popili_version(
    name = "on_unregistered",
    tags = ["manual"],
    target = ":modern",
    version = "9.9.9",
)

pinning_failure_test(
    name = "on_unregistered_test",
    expected_messages = [
        '//:modern needs popili "9.9.9" (forced by --@rules_coco//:force_version or with_popili_version)',
        'Registered versions: "1.5.0" (default when --@rules_coco//:version is unset), "1.5.1"',
    ],
    target_under_test = ":on_unregistered",
)

# ---------------------------------------------------------------------------------------------
# Execution platforms: the package hands each consumer the popili built for where it runs
# ---------------------------------------------------------------------------------------------

# Execution platforms registered by the analysis tests below (see exec_platform_tests.bzl).
# Neither is the host on CI, so a consumer constrained to one runs somewhere other than where
# the package is otherwise analysed. popili is published for the first and not for the second.
platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "linux_riscv64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:riscv64",
    ],
)

# Draw :modern while running on the extra platform. A diagram rather than coco_generate: it
# has no companion target, and declares outputs of its own. Manual: outside the analysis
# tests' configuration there is no such platform to land on.
[
    coco_state_diagram(
        name = "modern_states_on_%s" % platform,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        package = ":modern",
        tags = ["manual"],
    )
    for platform, cpu in [
        ("linux_aarch64", "aarch64"),
        ("linux_riscv64", "riscv64"),
    ]
]

exec_platform_runs_package_version_test(
    name = "exec_platform_runs_package_version_test",
    expected_repo = "io_cocotec_coco_linux_aarch64__1_5_0",
    target_under_test = ":modern_states_on_linux_aarch64",
)

exec_platform_unpublished_test(
    name = "exec_platform_unpublished_test",
    expected_messages = [
        "//:modern_states_on_linux_riscv64 runs popili 1.5.0 for",
        "//:modern on its execution platform, but no Coco toolchain of that version is registered for it.",
        "rules_coco publishes popili for osx_aarch64, linux_aarch64, linux_x86_64, windows_x86_64",
    ],
    target_under_test = ":modern_states_on_linux_riscv64",
)

# The platform is published for, but the licence mode reads a licence on the host: refused, so
# that a licence installed (local_user) or acquired (local_acquire) on a Mac is never handed to
# a Linux popili.
[
    test(
        name = "exec_platform_%s_license_test" % mode,
        expected_messages = [
            "//:modern_states_on_linux_aarch64 runs popili for",
            '//:modern with license_source "%s", which reads a licence on the host' % mode,
            "but its execution platform is linux_aarch64",
        ],
        target_under_test = ":modern_states_on_linux_aarch64",
    )
    for mode, test in [
        ("local_user", exec_platform_local_user_license_test),
        ("local_acquire", exec_platform_local_acquire_license_test),
    ]
]

# ---------------------------------------------------------------------------------------------
# Typecheck runs the package's version, from its own pin or its workspace's
# ---------------------------------------------------------------------------------------------

# legacy pins 1.5.1 itself; 1.5.0 is the default.
typecheck_test(
    name = "legacy_typecheck_is_151_test",
    expected_repo_suffix = "__1_5_1",
    mnemonic = "CocoTypecheck",
    target_under_test = ":legacy",
)

typecheck_test(
    name = "legacy_cpp_waits_for_typecheck_test",
    expected_marker = "legacy.typecheck",
    expected_repo_suffix = "__1_5_1",
    mnemonic = "CocoGenerate",
    target_under_test = ":legacy_cpp",
)

# ws_app inherits 1.5.0 from ws150. With --@rules_coco//:version=1.5.1 an unpinned package would
# use 1.5.1, so these tell the inherited pin apart from the default.
typecheck_flag_151_test(
    name = "ws_app_typecheck_is_150_test",
    expected_repo_suffix = "__1_5_0",
    mnemonic = "CocoTypecheck",
    target_under_test = ":ws_app",
)

typecheck_flag_151_test(
    name = "ws_app_cpp_waits_for_typecheck_test",
    expected_marker = "ws_app.typecheck",
    expected_repo_suffix = "__1_5_0",
    mnemonic = "CocoGenerate",
    target_under_test = ":ws_app_cpp",
)
