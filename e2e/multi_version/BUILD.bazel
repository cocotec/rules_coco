# E2E test for multi-version support in rules_coco
# This BUILD file demonstrates using different popili versions for different packages
# using the with_popili_version() wrapper

load("@bazel_features//:features.bzl", "bazel_features")
load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("@rules_coco//coco:cc.bzl", "coco_cc_library")
load("@rules_coco//coco:defs.bzl", "coco_fmt_test", "coco_generate", "coco_package", "coco_verify_test", "with_popili_version")
load("@rules_coco//test/popili_diagnostics:diagnostics_test.bzl", "popili_diagnostics_tests")
load(":popili_version_report.bzl", "popili_version_report")
load(":stub_cc_toolchain.bzl", "stub_cc_toolchain_config")
load(":test_platform_test.bzl", "test_platform_popili_test")

# Which popili a target actually resolves is asserted directly, rather than inferred from a
# successful verify: every registered version can verify every package here, so the verify
# tests below pass whichever toolchain they get. Works identically in WORKSPACE and bzlmod.
#
# popili_version_report fails during analysis, so these need only be part of //... -- no test
# rule, and deliberately no build_test, whose generated genrules need a working bash.

# Unwrapped: the first entry of versions/coco.toolchain is the default.
popili_version_report(
    name = "popili_is_150_by_default",
    expected_repo_suffix = "__1_5_0",
    expected_version = "1.5.0",
)

# Wrapped: the version flag, set here by a transition, selects the other registered version.
# Manual, because built directly it would resolve the default version and fail by design; it is
# reached only through the wrapper below.
popili_version_report(
    name = "popili_is_151_impl",
    expected_repo_suffix = "__1_5_1",
    expected_version = "1.5.1",
    tags = ["manual"],
)

with_popili_version(
    name = "popili_is_151",
    target = ":popili_is_151_impl",
    version = "1.5.1",
)

# Modern package - uses 1.5.0
coco_package(
    name = "modern",
    srcs = ["modern/src/Example.coco"],
    package = "modern/Coco.toml",
)

with_popili_version(
    name = "modern_v150",
    target = ":modern",
    version = "1.5.0",
)

# NOTE: these verify tests take a wrapped package but are not wrapped themselves. The
# with_popili_version transition is incoming, so it reaches the package and its deps but not
# the test consuming it -- these run the *default* popili, not the version the package asks
# for. The popili_version_report targets above are what actually pin version selection.
coco_verify_test(
    name = "modern_verify",
    package = ":modern_v150",
)

coco_fmt_test(
    name = "modern_fmt",
    package = ":modern_v150",
)

coco_generate(
    name = "modern_cpp",
    language = "cpp",
    package = ":modern_v150",
)

with_popili_version(
    name = "modern_cpp_v150",
    target = ":modern_cpp",
    version = "1.5.0",
)

coco_cc_library(
    name = "modern_cc_impl",
    generated_package = ":modern_cpp_v150",
    tags = ["manual"],
)

with_popili_version(
    name = "modern_cc",
    target = ":modern_cc_impl",
    version = "1.5.0",
)

# Legacy package - uses 1.5.1
coco_package(
    name = "legacy",
    srcs = ["legacy/src/Example.coco"],
    package = "legacy/Coco.toml",
)

with_popili_version(
    name = "legacy_v151",
    target = ":legacy",
    version = "1.5.1",
)

coco_verify_test(
    name = "legacy_verify",
    package = ":legacy_v151",
)

coco_generate(
    name = "legacy_cpp",
    language = "cpp",
    package = ":legacy_v151",
)

with_popili_version(
    name = "legacy_cpp_v151",
    target = ":legacy_cpp",
    version = "1.5.1",
)

coco_cc_library(
    name = "legacy_cc_impl",
    generated_package = ":legacy_cpp_v151",
    tags = ["manual"],
)

with_popili_version(
    name = "legacy_cc",
    target = ":legacy_cc_impl",
    version = "1.5.1",
)

# Flexible package - also uses 1.5.0
coco_package(
    name = "flexible",
    srcs = ["flexible/src/Example.coco"],
    package = "flexible/Coco.toml",
)

with_popili_version(
    name = "flexible_v150",
    target = ":flexible",
    version = "1.5.0",
)

coco_verify_test(
    name = "flexible_verify",
    package = ":flexible_v150",
)

coco_generate(
    name = "flexible_cpp",
    language = "cpp",
    package = ":flexible_v150",
)

with_popili_version(
    name = "flexible_cpp_v150",
    target = ":flexible_cpp",
    version = "1.5.0",
)

coco_cc_library(
    name = "flexible_cc_impl",
    generated_package = ":flexible_cpp_v150",
    tags = ["manual"],
)

with_popili_version(
    name = "flexible_cc",
    target = ":flexible_cc_impl",
    version = "1.5.0",
)

# Foreign to every CI host; test_platform_test.bzl targets it, with the host as first execution platform.
platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

# The Coco toolchain carries the C++ runtime, which needs a C++ toolchain for :linux_aarch64. Only
# test_platform_test.bzl registers this one, and it only analyses.
stub_cc_toolchain_config(name = "stub_cc_toolchain_config")

cc_toolchain(
    name = "stub_cc_toolchain",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":stub_cc_toolchain_config",
)

filegroup(name = "empty")

toolchain(
    name = "linux_aarch64_stub_cc_toolchain",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = ":stub_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# Bazel 8 has no default test toolchain type, so its tests are not tied to the target platform.
TESTS_FOLLOW_TARGET_PLATFORM = getattr(
    bazel_features.toolchains,
    "has_default_test_toolchain_type",
    False,
)

[
    test_platform_popili_test(
        name = test + "_popili_follows_test_platform",
        expected_repo = "io_cocotec_coco_linux_aarch64__1_5_0",
        target_under_test = ":" + test,
    )
    for test in [
        "modern_verify",
        "modern_fmt",
    ]
    if TESTS_FOLLOW_TARGET_PLATFORM
]

popili_diagnostics_tests(
    name = "popili_diagnostics",
    registered_versions = [
        "1.5.0",
        "1.5.1",
    ],
    targets = {
        "cc_runtime": "@rules_coco//coco:cc_runtime",
        "fmt_test": ":modern_fmt",
        "generate": ":modern_cpp",
        "package": ":modern",
        "verify_test": ":modern_verify",
    },
    test_targets = [
        "fmt_test",
        "verify_test",
    ],
)
