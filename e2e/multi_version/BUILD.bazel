# E2E test for multi-version support in rules_coco: popili 1.5.0 and 1.5.1 are registered, and
# each target that runs popili picks its version with popili_version.

load("@rules_cc//cc:defs.bzl", "cc_test", "cc_toolchain")
load("@rules_coco//coco:cc.bzl", "coco_cc_library", "coco_cc_test_library")
load(
    "@rules_coco//coco:defs.bzl",
    "coco_fmt_test",
    "coco_generate",
    "coco_package",
    "coco_state_diagram",
    "coco_verify_test",
    "with_popili_version",
)
load("@rules_coco//coco/private:coco.bzl", "TESTS_FOLLOW_TARGET_PLATFORM")  # buildifier: disable=bzl-visibility
load("@rules_coco//test/popili_diagnostics:diagnostics_test.bzl", "popili_diagnostics_tests")
load(
    ":pinned_popili_test.bzl",
    "library_version_mismatch_test",
    "pinned_popili_tests",
    "popili_version_forced_default_test",
    "popili_version_forced_test",
)
load(":popili_version_report.bzl", "popili_version_report")
load(":stub_cc_toolchain.bzl", "stub_cc_toolchain_config")
load(":test_platform_test.bzl", "test_platform_popili_test")

# Which popili a target actually resolves is asserted directly, rather than inferred from a
# successful verify: every registered version can verify every package here, so the verify
# tests below pass whichever toolchain they get. Works identically in WORKSPACE and bzlmod.
#
# popili_version_report fails during analysis, so these need only be part of //... -- no test
# rule, and deliberately no build_test, whose generated genrules need a working bash.

# Unwrapped: the first entry of versions/coco.toolchain is the default.
popili_version_report(
    name = "popili_is_150_by_default",
    expected_version = "1.5.0",
)

# A rule without a popili_version of its own still takes its version from a with_popili_version
# wrapper. Manual, because built directly it would resolve the default version and fail by
# design; it is reached only through the wrapper below.
popili_version_report(
    name = "popili_is_151_impl",
    expected_version = "1.5.1",
    tags = ["manual"],
)

with_popili_version(
    name = "popili_is_151",
    target = ":popili_is_151_impl",
    version = "1.5.1",
)

# Modern package: everything that runs popili on it is pinned to 1.5.0.
coco_package(
    name = "modern",
    srcs = ["modern/src/Example.coco"],
    package = "modern/Coco.toml",
)

coco_verify_test(
    name = "modern_verify",
    package = ":modern",
    popili_version = "1.5.0",
)

coco_fmt_test(
    name = "modern_fmt",
    package = ":modern",
    popili_version = "1.5.0",
)

coco_generate(
    name = "modern_cpp",
    language = "cpp",
    package = ":modern",
    popili_version = "1.5.0",
)

# Pinned like its generator; 1.5.0 is the default, so neither pin changes the configuration.
coco_cc_library(
    name = "modern_cc",
    generated_package = ":modern_cpp",
    popili_version = "1.5.0",
)

coco_state_diagram(
    name = "modern_states",
    package = ":modern",
    popili_version = "1.5.0",
)

# Legacy package: pinned to 1.5.1, the version that is not the default.
coco_package(
    name = "legacy",
    srcs = ["legacy/src/Example.coco"],
    package = "legacy/Coco.toml",
)

coco_verify_test(
    name = "legacy_verify",
    package = ":legacy",
    popili_version = "1.5.1",
)

coco_fmt_test(
    name = "legacy_fmt",
    package = ":legacy",
    popili_version = "1.5.1",
)

coco_generate(
    name = "legacy_cpp",
    language = "cpp",
    mocks = True,
    package = ":legacy",
    popili_version = "1.5.1",
)

# Pinned like its generator, so it links the 1.5.1 runtime.
coco_cc_library(
    name = "legacy_cc",
    generated_package = ":legacy_cpp",
    popili_version = "1.5.1",
)

cc_test(
    name = "legacy_test",
    size = "small",
    srcs = ["legacy/test/legacy_test.cc"],
    deps = [":legacy_cc"],
)

# The default gmock stays in the test's configuration while the runtime follows the pin, so a test
# that also links gtest_main directly gets one googletest. Wrapping the library in
# with_popili_version built googletest twice, which Linux rejects.
coco_cc_test_library(
    name = "legacy_cc_tst",
    generated_package = ":legacy_cpp",
    popili_version = "1.5.1",
    deps = [":legacy_cc"],
)

cc_test(
    name = "legacy_mock_test",
    size = "small",
    srcs = ["legacy/test/legacy_mock_test.cc"],
    deps = [
        ":legacy_cc_tst",
        "@googletest//:gtest_main",
    ],
)

# Libraries whose runtime differs from the generator's version; reached only by the tests below.
coco_cc_library(
    name = "legacy_cc_at_150",
    generated_package = ":legacy_cpp",
    popili_version = "1.5.0",
    tags = ["manual"],
)

coco_cc_library(
    name = "legacy_cc_unpinned",
    generated_package = ":legacy_cpp",
    tags = ["manual"],
)

# One library over generators at 1.5.0 and 1.5.1: mixing versions in a library is an error, so
# each version needs a library of its own.
coco_cc_library(
    name = "mixed_cc",
    generated_packages = [
        ":modern_cpp",
        ":legacy_cpp",
    ],
    tags = ["manual"],
)

# Labels print as @@//... under bzlmod and //... in WORKSPACE mode, so the expectations start at ":".
library_version_mismatch_test(
    name = "library_pinned_elsewhere",
    size = "small",
    expected = [
        # A pin to the default under an empty flag is worded as written: (pinned by popili_version = "1.5.0").
        ":legacy_cc_at_150 links the Coco runtime of popili 1.5.0 (pinned by popili_version",
        "), but builds from ",
        ":legacy_cpp, generated by popili 1.5.1. A library and the code it builds from must come from the " +
        "same popili version: give ",
        ":legacy_cc_at_150 popili_version = \"1.5.1\", or pin ",
        ":legacy_cpp to 1.5.0, or leave ",
        ":legacy_cpp unpinned so that it follows the library.",
    ],
    target_under_test = ":legacy_cc_at_150",
)

library_version_mismatch_test(
    name = "library_unpinned",
    size = "small",
    expected = [
        ":legacy_cc_unpinned links the Coco runtime of popili 1.5.0 (the default), but builds from ",
        ":legacy_cpp, generated by popili 1.5.1.",
        ":legacy_cc_unpinned popili_version = \"1.5.1\"",
    ],
    target_under_test = ":legacy_cc_unpinned",
)

library_version_mismatch_test(
    name = "library_mixed_generators",
    size = "small",
    expected = [
        ":mixed_cc links the Coco runtime of popili 1.5.0 (the default), but builds from ",
        ":legacy_cpp, generated by popili 1.5.1.",
    ],
    target_under_test = ":mixed_cc",
)

# Forced, the pins of library and generator are both ignored, so they agree on the command line's
# version (or the default) and the mismatched libraries build. The unpinned library under a flag
# naming 1.5.1 would agree with its generator unforced, so it is left out.
[
    test(
        name = "library_%s_forced_%s" % (library, case),
        size = "small",
        expected_version = version,
        target_under_test = ":legacy_cc_%s._gen" % library,
    )
    for library, case, test, version in [
        ("at_150", "flag", popili_version_forced_test, "1.5.1"),
        ("at_150", "default", popili_version_forced_default_test, "1.5.0"),
        ("unpinned", "default", popili_version_forced_default_test, "1.5.0"),
    ]
]

coco_state_diagram(
    name = "legacy_states",
    package = ":legacy",
    popili_version = "1.5.1",
)

# Flexible package: unpinned, so it follows --@rules_coco//:version and otherwise the default.
coco_package(
    name = "flexible",
    srcs = ["flexible/src/Example.coco"],
    package = "flexible/Coco.toml",
)

coco_verify_test(
    name = "flexible_verify",
    package = ":flexible",
)

coco_fmt_test(
    name = "flexible_fmt",
    package = ":flexible",
)

coco_generate(
    name = "flexible_cpp",
    language = "cpp",
    package = ":flexible",
)

coco_cc_library(
    name = "flexible_cc",
    generated_package = ":flexible_cpp",
)

# An unpinned generator follows its library's pin.
coco_cc_library(
    name = "flexible_cc_at_151",
    generated_package = ":flexible_cpp",
    popili_version = "1.5.1",
)

pinned_popili_tests(
    name = "pinned_popili",
    pinned = {
        "1.5.0": {
            "modern_cc": ":modern_cc._gen",
            "modern_fmt": ":modern_fmt",
            "modern_fmt_binary": ":modern_fmt.format",
            "modern_generate": ":modern_cpp",
            "modern_states": ":modern_states",
            "modern_verify": ":modern_verify",
        },
        "1.5.1": {
            "flexible_cc_at_151": ":flexible_cc_at_151._gen",
            "legacy_cc": ":legacy_cc._gen",
            "legacy_cc_tst": ":legacy_cc_tst._gen",
            "legacy_fmt": ":legacy_fmt",
            "legacy_fmt_binary": ":legacy_fmt.format",
            "legacy_generate": ":legacy_cpp",
            "legacy_states": ":legacy_states",
            "legacy_verify": ":legacy_verify",
        },
    },
    reference = ":flexible_cpp",
    unpinned = {
        "flexible_cc": ":flexible_cc._gen",
        "flexible_fmt": ":flexible_fmt",
        "flexible_generate": ":flexible_cpp",
        "flexible_verify": ":flexible_verify",
    },
    wrapped = ":popili_is_151",
)

# Foreign to every CI host; test_platform_test.bzl targets it, with the host as first execution platform.
platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

# The Coco toolchain carries the C++ runtime, which needs a C++ toolchain for :linux_aarch64. Only
# test_platform_test.bzl registers this one, and it only analyses.
stub_cc_toolchain_config(name = "stub_cc_toolchain_config")

cc_toolchain(
    name = "stub_cc_toolchain",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":stub_cc_toolchain_config",
)

filegroup(name = "empty")

toolchain(
    name = "linux_aarch64_stub_cc_toolchain",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = ":stub_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# Only on Bazel 9+ does a test run on an execution platform matching its target platform.
[
    test_platform_popili_test(
        name = test + "_popili_follows_test_platform",
        expected_repo = "io_cocotec_coco_linux_aarch64__1_5_0",
        target_under_test = ":" + test,
    )
    for test in [
        "modern_verify",
        "modern_fmt",
    ]
    if TESTS_FOLLOW_TARGET_PLATFORM
]

# Unpinned consumers: a pin would win over the flag these tests set.
popili_diagnostics_tests(
    name = "popili_diagnostics",
    registered_versions = [
        "1.5.0",
        "1.5.1",
    ],
    targets = {
        "cc_library": ":flexible_cc._gen",
        "cc_runtime": "@rules_coco//coco:cc_runtime",
        "fmt_test": ":flexible_fmt",
        "generate": ":flexible_cpp",
        "package": ":flexible",
        "verify_test": ":flexible_verify",
    },
    test_targets = [
        "fmt_test",
        "verify_test",
    ],
)
