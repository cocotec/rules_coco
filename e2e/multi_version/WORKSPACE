# E2E multi-version test WORKSPACE

workspace(name = "rules_coco_multi_version_test")

load("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

# Use local development version of rules_coco
local_repository(
    name = "rules_coco",
    path = "../..",
)

load("@rules_coco//coco:repositories.bzl", "coco_repositories")

# Register both versions, mirroring MODULE.bazel. The first entry is the one used when
# --@rules_coco//:version is unset; the other is reachable via the flag or a popili_version pin.
coco_repositories(
    cc = True,
    # The stand-in for Boost of MODULE.bazel; labels here must be repository-absolute.
    cc_runtime_extra_deps = {
        "1.5.0": ["@rules_coco_multi_version_test//:runtime_extra_dep"],
        "1.5.1": ["@rules_coco_multi_version_test//:runtime_extra_dep"],
    },
    versions = [
        "1.5.0",
        "1.5.1",
    ],
)

load("@bazel_skylib//:workspace.bzl", "bazel_skylib_workspace")

# Registers the unittest toolchains the analysis tests in BUILD.bazel need.
bazel_skylib_workspace()

# Load GoogleTest for C++ unit tests (if needed)
load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "googletest",
    sha256 = "a436f388c7f1305c3fe30a6a21c490893d159cfd8dfdcf9eeb20983994192869",
    strip_prefix = "googletest-6450691fd7d07ef932582206fbafb1a513927e08",
    urls = ["https://github.com/google/googletest/archive/6450691fd7d07ef932582206fbafb1a513927e08.zip"],
)
