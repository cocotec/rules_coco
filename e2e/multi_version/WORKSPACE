# E2E multi-version test WORKSPACE

workspace(name = "rules_coco_multi_version_test")

load("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

# Use local development version of rules_coco
local_repository(
    name = "rules_coco",
    path = "../..",
)

load("@rules_coco//coco:repositories.bzl", "coco_repositories")

# Register both versions, mirroring MODULE.bazel. The first entry is the one used when
# --@rules_coco//:version is unset; the other is reachable via the flag or a
# with_popili_version transition.
coco_repositories(
    cc = True,
    versions = [
        "1.5.0",
        "1.5.1",
    ],
)

# Load GoogleTest for C++ unit tests (if needed)
load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "googletest",
    sha256 = "65ebe885415306aa10e99e99f33bcd64b1b96f68fb6881bf760dba1234668777",
    strip_prefix = "googletest-a8380b01a25ebdb130097b607b3afed2a58d04ba",
    urls = ["https://github.com/google/googletest/archive/a8380b01a25ebdb130097b607b3afed2a58d04ba.zip"],
)
