# E2E multi-version test WORKSPACE

workspace(name = "rules_coco_multi_version_test")

load("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

# Use local development version of rules_coco
local_repository(
    name = "rules_coco",
    path = "../..",
)

load("@rules_coco//coco:repositories.bzl", "coco_repositories")

# Register both versions, mirroring MODULE.bazel. The first entry is the one used when
# --@rules_coco//:version is unset; the other is reachable via popili_version pins, the flag or
# with_popili_version.
coco_repositories(
    cc = True,
    versions = [
        "1.5.0",
        "1.5.1",
    ],
)

# Registers the unittest toolchain that the analysis tests in BUILD.bazel need. coco_repositories
# declares @bazel_skylib when the WORKSPACE doesn't.
load("@bazel_skylib//:workspace.bzl", "bazel_skylib_workspace")

bazel_skylib_workspace()

# Load GoogleTest for C++ unit tests (if needed)
load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "googletest",
    sha256 = "12ef65654dc01ab40f6f33f9d02c04f2097d2cd9fbe48dc6001b29543583b0ad",
    strip_prefix = "googletest-8d51ffdfab10b3fba636ae69bc03da4b54f8c235",
    urls = ["https://github.com/google/googletest/archive/8d51ffdfab10b3fba636ae69bc03da4b54f8c235.zip"],
)
