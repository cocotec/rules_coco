// Non-generic, so HideImplementation keeps SwitchImpl's implementation in
// Switch.cc, behind the class Switch.h declares.

port Switch {
  function on() : Nil
  function off() : Nil

  machine M {
    state Off {
      on() = setNextState(On)
      off() = illegal
    }
    state On {
      off() = setNextState(Off)
      on() = illegal
    }
  }
}

@runtime(.SingleThreaded)
external component SwitchDriver {
  val p : Provided<Switch>
}

@runtime(.SingleThreaded)
component SwitchImpl {
  val p : Provided<Switch>

  machine M {
    state Off {
      p.on() = setNextState(On)
      p.off() = illegal
    }
    state On {
      p.off() = setNextState(Off)
      p.on() = illegal
    }
  }
}
