load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_coco//coco:cc.bzl", "coco_cc_library", "coco_cc_test_library")
load("@rules_coco//coco:defs.bzl", "coco_generate", "coco_package", "with_popili_version")

# componentStyle = "HideImplementation" makes popili write a `<Module>_impl`
# header and implementation file for every module, next to the regular pair.
# cpp_component_style tells rules_coco to expect them. Over-declaring fails the
# generate action with "output ... was not created"; under-declaring is silent
# there, because the sandbox discards files nobody declared, and shows up when
# App.cc cannot find Relay_impl.h. The cc_test below exists to catch that.
#
# The _impl outputs arrived with generic components, which need popili 1.6, so
# every target is built with the "testing" version rather than the default. The
# unwrapped targets are manual: built directly they would run the default popili,
# which rejects language standard 2026. Once 1.6 is the stable release, drop the
# with_popili_version wrappers and the manual tags.

coco_package(
    name = "hide_implementation_test",
    srcs = glob(["src/**/*.coco"]),
    package = "Coco.toml",
    tags = ["manual"],
)

with_popili_version(
    name = "hide_implementation_test_testing",
    target = ":hide_implementation_test",
    version = "testing",
)

coco_generate(
    name = "hide_implementation_test_cpp",
    cpp_component_style = "HideImplementation",
    language = "cpp",
    mocks = True,
    package = ":hide_implementation_test_testing",
    tags = ["manual"],
)

with_popili_version(
    name = "hide_implementation_test_cpp_testing",
    target = ":hide_implementation_test_cpp",
    version = "testing",
)

coco_cc_library(
    name = "hide_implementation_test_cc_impl",
    generated_package = ":hide_implementation_test_cpp_testing",
    tags = ["manual"],
)

with_popili_version(
    name = "hide_implementation_test_cc",
    target = ":hide_implementation_test_cc_impl",
    version = "testing",
)

# Mock outputs are test outputs; the _impl pair is not. Both are generated by
# the same action, so this checks they do not get mixed up.
coco_cc_test_library(
    name = "hide_implementation_test_cc_tst_impl",
    generated_package = ":hide_implementation_test_cpp_testing",
    tags = ["manual"],
    deps = [":hide_implementation_test_cc"],
)

with_popili_version(
    name = "hide_implementation_test_cc_tst",
    target = ":hide_implementation_test_cc_tst_impl",
    version = "testing",
)

cc_test(
    name = "unit",
    srcs = ["test/app_test.cc"],
    deps = [
        ":hide_implementation_test_cc",
        ":hide_implementation_test_cc_tst",
        "@googletest//:gtest_main",
    ],
)
