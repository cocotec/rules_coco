"""Formatting support for Coco packages."""

load("//coco/private:coco.bzl", "CocoPackageInfo", "popili_rule")
load("//coco/private:common_attrs.bzl", "companion_attrs")

def _coco_fmt_test_impl(ctx, popili):
    """Implementation for coco_fmt_test rule.

    Creates a test that runs 'popili format --verify' to check if Coco code
    is properly formatted. The test passes if code is formatted correctly,
    and fails if formatting changes are needed.
    """
    arguments = [
        "format",
        "--verify",
    ]

    return DefaultInfo(
        executable = popili.script(arguments),
        runfiles = ctx.runfiles(transitive_files = popili.runfiles),
    )

_coco_fmt_test = popili_rule(
    implementation = _coco_fmt_test_impl,
    package = True,
    test = True,
)

def _coco_fmt_binary_impl(ctx, popili):
    """Implementation for coco_fmt_binary rule.

    Creates an executable that runs 'popili format' to format Coco code.
    """
    arguments = [
        "format",
    ]

    return DefaultInfo(
        executable = popili.script(arguments),
        runfiles = ctx.runfiles(transitive_files = popili.runfiles),
    )

_coco_fmt_binary = popili_rule(
    implementation = _coco_fmt_binary_impl,
    package = True,
    doc = """Binary rule that formats Coco code.

This rule creates an executable target that runs `popili format` on the
specified coco_package, automatically formatting all Coco source files
according to the formatting settings in the package's Coco.toml file.

This target is typically auto-generated by coco_fmt_test and should not
be used directly.
""",
    executable = True,
)

def _coco_fmt_test_macro_impl(name, visibility, package, popili_version = None, **kwargs):
    # Test target (the macro's primary target); test attrs flow through kwargs.
    _coco_fmt_test(
        name = name,
        package = package,
        popili_version = popili_version,
        visibility = visibility,
        **kwargs
    )

    # Companion `bazel run` formatter. Named "<name>.format" because symbolic-macro
    # naming requires the macro-name prefix; it formats with the same popili as the test,
    # and otherwise only common attrs are forwarded.
    _coco_fmt_binary(
        name = name + ".format",
        package = package,
        popili_version = popili_version,
        visibility = visibility,
        **companion_attrs(kwargs)
    )

coco_fmt_test = macro(
    doc = """Create a Coco format-check test plus a companion formatter target.

Two targets are created:

- `<name>`: a test, run with `bazel test`, that runs `popili format --verify`
  and fails if the package's Coco sources are not formatted according to the
  settings in its `Coco.toml`.
- `<name>.format`: an executable target, run with `bazel run`, that formats the
  sources in place with `popili format`.

Example:

```starlark
coco_package(
    name = "my_pkg",
    package = "Coco.toml",
    srcs = glob(["src/**/*.coco"]),
)

coco_fmt_test(
    name = "my_pkg_fmt_test",
    package = ":my_pkg",
)
```

`bazel run //path/to:my_pkg_fmt_test.format` then formats the sources. To leave
the test out of `bazel test //...`, set `tags = ["manual"]`.""",
    inherit_attrs = _coco_fmt_test,
    attrs = {
        "package": attr.label(
            providers = [CocoPackageInfo],
            mandatory = True,
            configurable = False,
            doc = "The `coco_package` whose sources to check and format.",
        ),
    },
    implementation = _coco_fmt_test_macro_impl,
)
