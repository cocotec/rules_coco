"""Bazel module for rules_coco - Coco/Popili verification tool rules."""

module(
    name = "rules_coco",
    version = "0.3.2",
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.14")  # Required for public C++ API

bazel_dep(name = "rules_python", version = "2.4.2", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)

# TODO: this is only here to get a version of protobuf that is compatible with the version of abseil used by googletest
bazel_dep(name = "protobuf", version = "36.2", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)

# Coco toolchain extension. This usage declares no toolchain, so a consumer gets exactly the
# coco.toolchain tags in its own dependency graph, or the extension's default (stable, with the
# C and C++ runtimes) when nobody declares one. rules_coco's .bzl files refer to the extension's
# repositories by the names below, so consumers inherit this use_repo and the registration and
# need neither themselves.
coco = use_extension("//coco:extensions.bzl", "coco")
use_repo(
    coco,
    "coco_toolchains",
    "io_cocotec_coco_preferences",
    "io_cocotec_licensing_fetch",
    "io_cocotec_licensing_local",
)

# Register all toolchains - inherited by consumers automatically
register_toolchains("@coco_toolchains//:all")

# The toolchain rules_coco's own tests run with: the same as the extension's default. A dev
# dependency, so it never reaches consumers (e2e/default_toolchain covers the default path).
coco_dev = use_extension("//coco:extensions.bzl", "coco", dev_dependency = True)
coco_dev.toolchain(
    c = True,
    cc = True,
    versions = ["stable"],
)
